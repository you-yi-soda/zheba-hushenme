/* Override style:v2 button dimensions explicitly, including inside sheets. */
.page .ui,.sheet .ui{width:auto;min-width:0;max-width:none;height:auto;margin:0;padding:0;border:0;border-radius:0;background:transparent;color:inherit;font-size:inherit;font-weight:400;line-height:1.5;box-sizing:border-box;box-shadow:none;overflow:visible;text-align:center;flex-shrink:0}
.page .ui::after,.sheet .ui::after{border:0}
.page .ui[disabled],.sheet .ui[disabled]{opacity:.38}
.page{padding:30rpx 32rpx 0}
.header{display:flex;align-items:center;justify-content:space-between;margin-bottom:26rpx}
.brand{display:flex;align-items:center}
.logo{width:70rpx;height:80rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-right:17rpx;background:#173d32;border-radius:17rpx;color:#f5f2df;font-family:serif;font-size:53rpx;box-shadow:inset 0 -7rpx #0e2d24}
.brand-title{font-size:35rpx;font-weight:700;letter-spacing:1rpx}
.brand-en{font-size:14rpx;letter-spacing:4rpx;color:#7b887c;margin-top:5rpx}
.page .rule-button{border:1rpx solid #dce0d5;border-radius:45rpx;padding:14rpx 17rpx;font-size:21rpx;white-space:nowrap}
.mode{display:flex;background:#e9eddf;padding:7rpx;border-radius:21rpx;margin-bottom:24rpx}
.page .mode-button{flex:1;min-width:0;padding:13rpx 0 11rpx;font-size:26rpx;border-radius:15rpx;white-space:nowrap;font-weight:600}
.mode-button text{display:block;font-size:19rpx;color:#839077;margin-top:3rpx;font-weight:400}
.page .mode-button.selected{background:#fafbf5;box-shadow:0 4rpx 12rpx #274c2510}
.scanner{border-radius:29rpx;padding:26rpx;background:radial-gradient(ellipse at 50% 55%,#315a43 0%,#143c31 80%);box-shadow:0 10rpx 24rpx #163e3115;color:#e7ebd9;overflow:hidden}
.viewfinder{height:245rpx;position:relative;display:flex;align-items:center;justify-content:center;margin-bottom:22rpx;overflow:hidden}
.photo{position:absolute;width:100%;height:100%}
.sample-tiles{display:flex;justify-content:center;align-items:center;transform:rotate(-5deg);padding:25rpx 0}
.tile,.page .tile-button,.sheet .palette-tile{display:flex;position:relative;align-items:center;justify-content:center;flex:none;width:68rpx;min-width:68rpx;max-width:68rpx;height:94rpx;min-height:94rpx;padding:5rpx;border:1rpx solid #e1e0d1;border-radius:9rpx;background:linear-gradient(145deg,#fffef7,#eeeddf);box-shadow:0 6rpx 0 #d6d7c6;box-sizing:border-box;overflow:hidden;line-height:1}
.tile-art{display:block;width:100%;height:100%;pointer-events:none}
.sample-tile{width:75rpx;min-width:75rpx;max-width:75rpx;height:106rpx;min-height:106rpx;margin:0 4rpx;box-shadow:0 8rpx 0 #c5c6ae,0 15rpx 26rpx #00180a66}
.sample-tile:nth-child(3){transform:translateY(-6rpx)}
.corner{position:absolute;top:7rpx;width:29rpx;height:29rpx;border:0 solid #b8caaa;pointer-events:none}
.top-left{left:7rpx;border-top-width:2rpx;border-left-width:2rpx}
.top-right{right:7rpx;border-top-width:2rpx;border-right-width:2rpx}
.page .primary,.sheet .primary{width:100%;display:flex;align-items:center;justify-content:center;padding:23rpx 28rpx;min-height:92rpx;background:#d8ef9b;border:1rpx solid #d1e590;border-radius:20rpx;color:#23472d;font-size:27rpx;font-weight:600}
.page .camera-button{justify-content:flex-start;white-space:nowrap}
.camera-icon{font-size:40rpx;margin-right:18rpx;line-height:1}
.arrow{margin-left:auto;font-size:38rpx;line-height:1}
.secondary-actions{display:flex;align-items:center;margin:24rpx 0 34rpx}
.page .secondary-button{display:flex;align-items:center;justify-content:center;flex:1;min-width:0;min-height:90rpx;padding:18rpx 5rpx;border:1rpx solid #d6dfc4;border-radius:20rpx;background:#eff3e6;font-size:24rpx;font-weight:600;white-space:nowrap}
.page .secondary-button + .secondary-button{margin-left:16rpx}
.secondary-button text{font-size:32rpx;margin-right:12rpx;font-weight:400;line-height:1}
.section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx;min-height:44rpx}
.section-name{display:flex;align-items:center;white-space:nowrap;font-size:28rpx;font-weight:600}
.count{font-size:21rpx;color:#92998c;margin-left:16rpx;font-weight:400}
.actions{display:flex;align-items:center;flex-shrink:0}
.actions .ui{font-size:21rpx;padding:10rpx 0 10rpx 20rpx;color:#7e8976;white-space:nowrap}
.page .empty-add{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;min-height:235rpx;padding:35rpx 0;border:1rpx dashed #d2ddbf;border-radius:22rpx;background:#eff3e5;font-size:28rpx;font-weight:600}
.empty-plus{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;margin-bottom:14rpx;border-radius:50%;background:#dee7c9;font-size:45rpx;font-weight:400;line-height:1}
.hand{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:21rpx 12rpx;padding:3rpx 4rpx 10rpx 0}
.hand-tile{position:relative;min-width:0}
.page .hand .tile-button{width:100%;min-width:0;max-width:none;height:115rpx;min-height:115rpx;padding:5rpx}
.page .tile-button.uncertain{border:3rpx solid #d79d33}
.page .tile-remove{position:absolute;z-index:1;top:-11rpx;right:-9rpx;display:flex;align-items:center;justify-content:center;width:36rpx;height:36rpx;border-radius:50%;border:2rpx solid #fff8ef;background:#e95b50;color:white;font-size:30rpx;font-weight:500;line-height:1}
/* Enlarge the touch area without obscuring the neighboring tile face. */
.page .tile-remove::before{content:'';position:absolute;top:-6rpx;right:-6rpx;bottom:-6rpx;left:-6rpx}
.page .hand-add{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:115rpx;border:1rpx dashed #bfcea9;border-radius:10rpx;background:#eff3e7}
.hand-add view{font-size:40rpx;line-height:1.1}
.hand-add text{font-size:19rpx;color:#879278;margin-top:6rpx}
.hand-meta{display:flex;align-items:center;justify-content:space-between;min-height:64rpx;margin-top:18rpx}
.page .delete-hand{padding:8rpx 17rpx;border:1rpx solid #c78b77;border-radius:14rpx;background:#fffaf2;color:#a9624f;font-size:22rpx;white-space:nowrap}
.page .delete-hand.active{background:#173d32;border-color:#173d32;color:#fffdf3}
.que-picker{font-size:20rpx;color:#7a856f;background:#ebeede;padding:12rpx 18rpx;border-radius:13rpx;white-space:nowrap}
.meld-tools{display:flex;justify-content:space-between;align-items:center;font-size:21rpx;color:#939b8c;margin-top:17rpx;padding-top:14rpx;border-top:1rpx solid #e4e6dd}
.meld-actions{display:flex}
.meld-actions .ui{font-size:22rpx;color:#6d805f;margin-left:24rpx;padding:6rpx 0;white-space:nowrap}
.meld-entry{display:flex;align-items:center;padding:18rpx 0;border-bottom:1rpx solid #e4e6dd;font-size:23rpx}
.meld-entry .tile{margin-right:20rpx}
.meld-entry .ui{margin-left:auto;font-size:22rpx;color:#ad7563;padding:12rpx}
.review{font-size:22rpx;color:#927436;line-height:1.8;margin-top:26rpx}
.review .primary{margin-top:15rpx;font-size:23rpx}
.result{border:1rpx solid #e2e6d6;border-radius:25rpx;background:#eff2e6;margin-top:26rpx;padding:28rpx}
.answer{font-size:39rpx;line-height:1.4;font-weight:700;letter-spacing:-1rpx}
.result-note,.footnote{font-size:20rpx;color:#78856b;line-height:1.8;margin-top:14rpx}
.result-error{background:#f6eee2;border-color:#e9dabe}
.waits{display:flex;flex-wrap:wrap;margin-top:18rpx}
.page .wait-item{display:flex;flex-direction:column;align-items:center;margin:0 28rpx 12rpx 0}
.tile.large{width:85rpx;min-width:85rpx;max-width:85rpx;height:116rpx;min-height:116rpx}
.wait-label{font-size:19rpx;color:#768366;margin-top:13rpx}
.page .proof-toggle{width:100%;display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid #d9dfcc;text-align:left;padding-top:16rpx;margin-top:12rpx;font-size:22rpx;color:#67795b}
.proof-toggle text{font-size:30rpx;line-height:1}
.proof{font-size:22rpx;line-height:1.9;color:#67795b;margin-top:15rpx;word-break:break-all}
.proof-heading{font-weight:600}
.proof-line{margin-bottom:20rpx}
.discard{padding:20rpx 0;border-top:1rpx solid #dce3d0;margin-top:18rpx}
.page .discard-button{width:100%;text-align:left}
.discard-heading{display:flex;align-items:center;font-size:25rpx}
.discard-heading .tile{margin:0 15rpx}
.discard-name{font-weight:600}
.discard-count{margin-left:auto;font-size:18rpx;color:#728064}
.discard-waits{font-size:22rpx;color:#788769;margin-top:16rpx;line-height:1.7}
.tile.mini{width:49rpx;min-width:49rpx;max-width:49rpx;height:68rpx;min-height:68rpx;padding:3rpx}
.footer{text-align:center;padding:32rpx 0 calc(28rpx + env(safe-area-inset-bottom))}
.page .help-button{display:inline-block;font-size:20rpx;color:#8b9582;padding:12rpx 30rpx}
.overlay{position:fixed;top:0;right:0;bottom:0;left:0;background:#0d241e66;z-index:10;display:flex;align-items:flex-end}.sheet{width:100%;background:#f6f5ef;color:#173d32;border-radius:40rpx 40rpx 0 0;padding:42rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));box-sizing:border-box;max-height:88vh;overflow-y:auto}.sheet-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:35rpx}.sheet-title{font-size:36rpx;font-weight:600}.sheet-hint{font-size:21rpx;color:#7f8975;margin-top:12rpx}.sheet .close-button{font-size:50rpx;line-height:50rpx;width:55rpx;color:#87957d}.palette-suit{margin-bottom:32rpx}.palette-label{font-size:21rpx;color:#839277;margin-bottom:15rpx}.palette-row{display:flex;justify-content:space-between}.sheet .palette-tile{width:calc((100% - 48rpx) / 9);min-width:0;max-width:none;height:94rpx;min-height:94rpx}.used{position:absolute;top:0;right:3rpx;font-size:16rpx;color:#6d7a61;background:#f6f5efcc;border-radius:3rpx;padding:0 3rpx}.picker-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid #e4e6dd;padding-top:28rpx;font-size:23rpx;color:#7f8975}.picker-actions{display:flex;align-items:center}.sheet .picker-undo{width:150rpx;min-height:80rpx;padding:17rpx 0;margin-right:16rpx;border:1rpx solid #8fa37c;border-radius:20rpx;color:#23472d;font-size:25rpx}.sheet .done-button{width:165rpx;min-height:80rpx;padding:17rpx;font-size:25rpx}.picker-bottom>text{font-size:21rpx;white-space:nowrap}.sheet .delete{font-size:23rpx;color:#a07438;text-align:left;padding:10rpx 0 25rpx}.rule-line{display:flex;justify-content:space-between;align-items:center;font-size:25rpx;margin:25rpx 0}.rule-description{font-size:22rpx;color:#849078;line-height:1.9;margin:28rpx 0 38rpx}
@media(max-width:350px){.brand-title{font-size:32rpx}.brand-en{font-size:12rpx;letter-spacing:3rpx}.page .rule-button{font-size:19rpx;padding:13rpx}.page .secondary-button{font-size:23rpx}.sample-tile{width:73rpx;min-width:73rpx;max-width:73rpx}}

/* Read-only hand preview shares the live hand data with the picker count. */
.picker-selection{padding:22rpx;background:#e9eedf;border-radius:23rpx;margin-bottom:28rpx}
.picker-selection-title{display:flex;align-items:center;font-size:27rpx;font-weight:600;margin-bottom:18rpx}
.picker-selection-title text{font-size:21rpx;color:#7f8d70;font-weight:400;margin-left:16rpx}
.picker-selected-hand{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:16rpx 10rpx;padding-bottom:5rpx}
.picker-selected-hand .picker-selected-tile{width:100%;min-width:0;max-width:none;height:106rpx;min-height:106rpx}
.picker-selected-tile.uncertain{border:3rpx solid #d79d33}

.sheet .source-offer{width:100%;min-height:80rpx;margin:0 0 18rpx;padding:18rpx;border:1rpx solid #d6dfc4;border-radius:20rpx;color:#426b49;font-size:24rpx}

/* v1.1: confirmed visual design and transactional hand review. */
.page{box-sizing:border-box;min-height:100vh;display:flex;flex-direction:column}
.logo{width:90rpx;height:90rpx;border-radius:20rpx;font-family:inherit;box-shadow:none;font-size:62rpx;margin-right:22rpx}
.brand-title{font-size:42rpx;letter-spacing:0}
.brand-en{font-size:19rpx;letter-spacing:1rpx}
.page .rule-button{font-size:22rpx;padding:14rpx 18rpx}
.scan-status{display:flex;align-items:center;justify-content:space-between;font-size:23rpx;color:#687c5a;padding:16rpx 4rpx 0;line-height:1.6}
.page .scan-status .ui{font-size:23rpx;padding:6rpx 16rpx;color:#7f6b45}
.hand-meta{padding:4rpx 0 8rpx;overflow:visible}
.page .delete-hand{min-height:62rpx;padding:12rpx 20rpx;border:2rpx solid #bf7e68;box-sizing:border-box;line-height:1.4;overflow:visible;box-shadow:inset 0 0 0 1rpx #bf7e6810}
.footer{display:flex;align-items:center;justify-content:center;margin-top:auto;padding-top:44rpx}
.page .help-button{padding:14rpx 22rpx;white-space:nowrap}
.footer-divider{font-size:25rpx;color:#d4ddc5;margin:0 8rpx}
.sheet.picker-sheet{height:88vh;padding:0;overflow:hidden;display:flex;flex-direction:column}
.picker-sheet .sheet-head{padding:30rpx 32rpx 20rpx;margin:0;flex-shrink:0}
.picker-sheet .sheet-title{font-size:36rpx}
.picker-sheet .sheet-hint{font-size:21rpx;line-height:1.5;margin-top:8rpx}
.picker-scroll{flex:1;min-height:0;height:calc(88vh - 350rpx)}
.picker-content{padding:0 30rpx 12rpx}
.review-notice,.picker-instruction{margin:2rpx 0 25rpx;padding:19rpx 22rpx;background:#edf1e3;border-radius:16rpx;font-size:21rpx;color:#687c5a;line-height:1.7}
.review-notice{background:#f5ebcb;color:#856328}
.review-notice view{font-weight:600}.review-notice text{font-size:20rpx}
.picker-selection{padding:22rpx;background:#edf1e2;border-radius:20rpx}
.picker-selection-title{justify-content:space-between;font-size:25rpx;line-height:1.5}
.picker-selection-title>view{display:flex;align-items:center;white-space:nowrap}
.picker-selection-title .picker-delete-hint{margin-left:8rpx;font-size:20rpx;color:#697e5f}
.picker-selected-hand{gap:18rpx 10rpx;padding-bottom:8rpx}
.sheet .picker-selected-tile{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;max-width:none;height:106rpx;min-height:106rpx;padding:5rpx;border:1rpx solid #c2cbb6;border-radius:9rpx;background:linear-gradient(145deg,#fffef7,#eeeddf);box-shadow:0 6rpx 0 #c1c8af;overflow:hidden;line-height:1}
.sheet .picker-selected-tile.replacing{border:3rpx solid #3b6f51}
.sheet .picker-selected-tile.uncertain{border:3rpx solid #d79d33}
.picker-empty{font-size:22rpx;color:#839277;padding:26rpx 0;line-height:1.8}
.picker-content .palette-suit{margin-bottom:27rpx}
.picker-content .palette-label{font-size:21rpx;margin-bottom:13rpx}
.used{top:auto;bottom:3rpx;right:1rpx;width:23rpx;height:23rpx;padding:0;border-radius:50%;background:#24513b;color:#fff;font-size:16rpx;display:flex;align-items:center;justify-content:center;line-height:1}
.picker-footer{border-top:1rpx solid #dce3d0;padding:20rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));flex-shrink:0;background:#f6f5ef}
.picker-count{display:flex;align-items:center;justify-content:space-between;font-size:23rpx;color:#23472d;margin-bottom:20rpx;gap:12rpx}
.picker-status{font-size:20rpx;color:#7f8d70;text-align:right;flex:1;min-width:0}
.picker-status.needs-edit{color:#a27638}
.picker-actions{display:flex;width:100%}
.sheet .picker-undo{width:175rpx;min-height:86rpx;padding:18rpx;border:1rpx solid #d6dfc4;background:#edf0e5;margin-right:20rpx;border-radius:20rpx;font-size:26rpx}
.sheet .done-button{width:auto;flex:1;min-height:86rpx;padding:18rpx;font-size:28rpx}
.sheet .done-button[disabled]{background:#e5e9d9;border-color:#e5e9d9;color:#9ca78e;opacity:1}
.picker-draft-note{text-align:center;font-size:20rpx;color:#8b9582;margin-top:18rpx}
.picker-meld-preview{display:flex;align-items:center;gap:22rpx;padding:15rpx 0 25rpx;font-size:27rpx}
.game-mode-sheet{padding-bottom:calc(65rpx + env(safe-area-inset-bottom))}
.sheet .game-mode-choice{display:flex;align-items:center;width:100%;padding:28rpx;background:#edf2e2;border:2rpx solid #c4d5b4;border-radius:24rpx;text-align:left}
.game-mode-icon{width:100rpx;height:100rpx;display:flex;align-items:center;justify-content:center;background:#173f33;color:#f7f6ef;border-radius:22rpx;font-size:56rpx;margin-right:26rpx}
.game-mode-label{font-size:32rpx;font-weight:600}
.game-mode-label text{display:block;font-size:22rpx;color:#7c8978;font-weight:400;margin-top:10rpx}
.game-mode-check{margin-left:auto;background:#173f33;border-radius:50%;width:42rpx;height:42rpx;text-align:center;line-height:42rpx;color:#f7f6ef;font-size:29rpx}
.help-section{margin:25rpx 0;font-size:24rpx;line-height:1.9;color:#77866b}.help-section view{color:#244a35;font-size:27rpx;font-weight:600;margin-bottom:8rpx}
@media(max-width:350px){.brand-title{font-size:37rpx}.brand-en{font-size:18rpx;letter-spacing:0}.page .rule-button{font-size:21rpx}.picker-selection-title .picker-delete-hint{font-size:19rpx}.picker-count{font-size:22rpx}.picker-status{font-size:19rpx}}
