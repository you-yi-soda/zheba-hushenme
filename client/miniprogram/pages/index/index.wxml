<view class="page" wx:if="{{ready}}">
  <view class="header">
    <view class="brand"><view class="logo">胡</view><view><view class="brand-title">这把胡什么</view><view class="brand-en">拍手牌 · 查听口</view></view></view>
    <button class="ui rule-button" bindtap="showGameModes">川麻 · 血战　⌄</button>
  </view>
  <view class="mode">
    <button class="ui mode-button {{mode === 'waits' ? 'selected' : ''}}" data-mode="waits" bindtap="changeMode"><view>胡什么</view><text>当前{{13 - melds.length * 3}}张</text></button>
    <button class="ui mode-button {{mode === 'discards' ? 'selected' : ''}}" data-mode="discards" bindtap="changeMode"><view>打哪张能听</view><text>当前{{14 - melds.length * 3}}张</text></button>
  </view>
  <view class="scanner">
    <view class="viewfinder">
      <image wx:if="{{photo}}" class="photo" src="{{photo}}" mode="aspectFit"/>
      <view wx:else class="sample-tiles"><view wx:for="{{sampleTiles}}" wx:key="id" class="tile sample-tile"><image class="tile-art" src="{{item.image}}" mode="aspectFit"/></view></view>
      <view class="corner top-left"></view><view class="corner top-right"></view>
    </view>
    <button class="ui primary camera-button" bindtap="choosePhoto" loading="{{busy}}" disabled="{{busy}}" data-source="camera"><text class="camera-icon">◎</text><text>{{busy ? '正在识牌…' : mode === 'waits' ? '打开相机查听口' : '打开相机看出牌'}}</text><text class="arrow">→</text></button>
  </view>
  <view wx:if="{{busy}}" class="scan-status"><text>{{busyText}}</text><button class="ui" bindtap="cancelRecognition">取消</button></view>
  <view class="secondary-actions">
    <button class="ui secondary-button" bindtap="choosePhoto" data-source="album" disabled="{{busy}}"><text>▧</text>从相册选照片</button>
    <button class="ui secondary-button" bindtap="openPicker"><text>▦</text>手动选牌</button>
  </view>
  <view class="section-title"><view class="section-name">我的手牌<text class="count">{{tiles.length}}张</text></view><view wx:if="{{tiles.length || photo}}" class="actions"><button class="ui" bindtap="newRound">新一局</button></view></view>
  <button wx:if="{{!tiles.length}}" class="ui empty-add" bindtap="openPicker"><view class="empty-plus">＋</view><view>添加手牌</view></button>
  <view wx:else class="hand">
    <view wx:for="{{tiles}}" wx:key="index" class="hand-tile">
      <button class="ui tile tile-button {{item.uncertain ? 'uncertain' : ''}}" data-index="{{item.index}}" bindtap="tapHandTile" aria-label="{{deleteMode ? '删除' : '修改'}}第{{index+1}}张{{item.name}}"><image class="tile-art" src="{{item.image}}" mode="aspectFit"/></button>
      <button wx:if="{{deleteMode}}" class="ui tile-remove" data-index="{{item.index}}" catchtap="removeHandTile" aria-label="删除第{{index+1}}张{{item.name}}">×</button>
    </view>
    <button class="ui hand-add" bindtap="openPicker" aria-label="添加手牌"><view>＋</view><text>添加</text></button>
  </view>
  <view class="hand-meta">
    <button wx:if="{{tiles.length}}" class="ui delete-hand {{deleteMode ? 'active' : ''}}" bindtap="toggleDeleteMode" aria-label="{{deleteMode ? '完成删除并收起标记' : '显示删除标记'}}">{{deleteMode ? '完成删除' : '删除手牌'}}</button><view wx:else></view>
    <picker range="{{queOptions}}" value="{{queIndex}}" bindchange="changeQue"><view class="que-picker">定缺：{{queOptions[queIndex]}} ⌄</view></picker>
  </view>
  <view class="meld-tools"><text>{{melds.length ? '已记录 ' + melds.length + ' 组碰杠' : '尚未记录碰杠'}}</text><view class="meld-actions"><button class="ui" data-meld="pong" bindtap="openPicker">＋ 碰</button><button class="ui" data-meld="kong" bindtap="openPicker">＋ 杠</button></view></view>
  <view class="meld-entry" wx:for="{{melds}}" wx:key="index"><view class="tile mini"><image class="tile-art" src="{{item.image}}" mode="aspectFit"/></view><text>{{item.typeLabel}} {{item.name}}</text><button class="ui" data-index="{{index}}" bindtap="removeMeld">删除</button></view>
  <view wx:if="{{!busy && !isEmpty}}" class="result {{error ? 'result-error' : ''}}">
      <view class="answer">{{title}}</view><view wx:if="{{error || !waits.length}}" class="result-note">{{error || note}}</view>
      <view wx:if="{{waits.length}}" class="waits"><button wx:for="{{waits}}" wx:key="id" class="ui wait-item" data-index="{{index}}" bindtap="toggleWait"><view class="tile large"><image class="tile-art" src="{{item.image}}" mode="aspectFit"/></view><view class="wait-label">{{item.name}} · 未见 {{item.unseen}}</view></button></view>
      <button wx:if="{{waits.length}}" class="ui proof-toggle" bindtap="toggleProof">查看拆牌依据<text>{{proofOpen ? '⌃' : '›'}}</text></button>
      <view wx:if="{{proofOpen}}" class="wait-proofs">
        <view wx:for="{{waits}}" wx:key="id" class="proof"><view class="proof-heading">{{item.name}} · {{item.type}}</view>{{item.proof}}<view wx:if="{{melds.length}}">另加已记录的碰杠。</view></view>
      </view>
      <view wx:if="{{winProof}}" class="proof">{{winProof}}<view wx:if="{{melds.length}}">另加已记录的碰杠。</view></view>
      <view wx:for="{{discards}}" wx:key="id" class="discard"><button class="ui discard-button" data-index="{{index}}" bindtap="toggleDiscard"><view class="discard-heading"><text>打</text><view class="tile mini"><image class="tile-art" src="{{item.image}}" mode="aspectFit"/></view><text class="discard-name">{{item.name}}</text><text class="discard-count">{{item.waits.length}} 种 · 未见 {{item.unseen}}</text></view><view class="discard-waits">听 {{item.waitText}}　⌄</view></button><view wx:if="{{expandedDiscard === index}}" class="proof"><view wx:for="{{item.waits}}" wx:for-item="waiting" wx:key="id" class="proof-line">{{waiting.name}} · 未见 {{waiting.unseen}} · {{waiting.type}}<view>{{waiting.proof}}</view></view></view></view>
      <view wx:if="{{!pending && (proofOpen || !waits.length)}}" class="footnote">未见张数不等于牌墙库存；不判断过胡、番数与放炮风险。{{queIndex === 0 ? '未设置定缺，仅展示牌型结果。' : ''}}</view>
  </view>
  <view class="footer"><button class="ui help-button" bindtap="showRules">ⓘ 使用说明</button><text class="footer-divider">|</text><button class="ui help-button" bindtap="showSource">‹› 开源与许可</button></view>
</view>
<view wx:if="{{picker}}" class="overlay" bindtap="closePicker" catchtouchmove="noop">
  <view class="sheet picker-sheet" catchtap="noop">
    <view class="sheet-head"><view><view class="sheet-title">{{pickerTitle}}</view><view class="sheet-hint">{{pickerHint}}</view></view><button class="ui close-button" bindtap="closePicker" aria-label="关闭并放弃本次修改">×</button></view>
    <scroll-view class="picker-scroll" scroll-y="{{true}}">
      <view class="picker-content">
        <view wx:if="{{pickerReview}}" class="review-notice"><view>黄色框需要特别核对</view><text>其他牌也请逐张检查，识别可能有错漏</text></view>
        <view wx:elif="{{!pickerIsMeld}}" class="picker-instruction">点下方牌库添加，点已选牌面删除单张</view>
        <view wx:if="{{!pickerIsMeld}}" class="picker-selection">
          <view class="picker-selection-title"><view>已选手牌<text>{{pickerTiles.length}}张</text></view><text class="picker-delete-hint">点击牌面可删除</text></view>
          <view wx:if="{{pickerTiles.length}}" class="picker-selected-hand">
            <button wx:for="{{pickerTiles}}" wx:key="index" class="ui tile picker-selected-tile {{item.uncertain ? 'uncertain' : ''}} {{item.replacing ? 'replacing' : ''}}" data-index="{{item.index}}" bindtap="removePickerTile" aria-label="删除第{{index+1}}张{{item.name}}"><image class="tile-art" src="{{item.image}}" mode="aspectFit"/></button>
          </view>
          <view wx:else class="picker-empty">还没有手牌，从下方牌库开始选牌</view>
        </view>
        <view wx:if="{{pickerMeld}}" class="picker-meld-preview"><view class="tile mini"><image class="tile-art" src="{{pickerMeld.image}}" mode="aspectFit"/></view><text>{{pickerMeld.label}} {{pickerMeld.name}}</text></view>
        <view wx:for="{{palette}}" wx:key="suit" class="palette-suit">
          <view class="palette-label">{{item.suit}}子</view><view class="palette-row">
            <button wx:for="{{item.tiles}}" wx:for-item="choice" wx:key="id" class="ui tile palette-tile" disabled="{{choice.disabled}}" data-id="{{choice.id}}" bindtap="chooseTile" aria-label="选择{{choice.name}}"><image class="tile-art" src="{{choice.image}}" mode="aspectFit"/><text wx:if="{{choice.used}}" class="used">{{choice.used}}</text></button>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="picker-footer">
      <view class="picker-count"><text>{{pickerIsMeld ? '记录碰杠' : '已选 ' + pickerTiles.length + ' / ' + pickerExpected + ' 张'}}</text><text class="picker-status {{pickerError || !pickerCanConfirm ? 'needs-edit' : ''}}">{{pickerError || pickerStatus}}</text></view>
      <view class="picker-actions"><button class="ui picker-undo" bindtap="undoPicker" disabled="{{!canPickerUndo}}">撤回</button><button class="ui primary done-button" bindtap="confirmPicker" disabled="{{!pickerCanConfirm}}">{{pickerIsMeld ? '确认记录' : '确认并计算'}}</button></view>
      <view class="picker-draft-note">确认前不替换首页手牌</view>
    </view>
  </view>
</view>
<view wx:if="{{gameModesOpen}}" class="overlay" bindtap="closeGameModes" catchtouchmove="noop"><view class="sheet game-mode-sheet" catchtap="noop">
  <view class="sheet-head"><view class="sheet-title">选择玩法</view><button class="ui close-button" bindtap="closeGameModes" aria-label="关闭玩法选择">×</button></view>
  <button class="ui game-mode-choice" bindtap="selectGameMode"><view class="game-mode-icon">川</view><view class="game-mode-label"><view>川麻 · 血战</view><text>当前玩法</text></view><text class="game-mode-check">✓</text></button>
</view></view>
<view wx:if="{{rulesOpen}}" class="overlay" bindtap="closeRules" catchtouchmove="noop"><view class="sheet" catchtap="noop">
  <view class="sheet-head"><view class="sheet-title">使用说明</view><button class="ui close-button" bindtap="closeRules" aria-label="关闭使用说明">×</button></view>
  <view class="help-section"><view>川麻 · 血战</view><text>普通胡、七对（四张算两对），默认支持七对。支持记录碰和杠，定缺在首页设置。</text></view>
  <view class="help-section"><view>查听口与看出牌</view><text>13张查听口，14张查打哪张能听；已有碰杠时按对应张数查询。未设置定缺时，只做牌型分析。</text></view>
  <view class="help-section"><view>识别后请核对</view><text>拍照或从相册选照片后，核对弹窗中的每张牌。点击已选牌删除，点下方牌库补充，确认后再计算。关闭弹窗会放弃本次修改。</text></view>
  <view class="help-section"><view>分享小程序</view><text>点右上角“···”，选择发给朋友或分享到朋友圈。若当前微信显示“复制链接”，可复制首页链接；入口以微信实际提供为准。</text></view>
  <view class="rule-description">未见张数不等于牌墙库存；暂不判断过胡、番数及放炮风险。识别可能有错漏，请以实际牌面和本桌规则为准。</view>
  <button class="ui primary" bindtap="closeRules">知道了</button>
</view></view>
